# AI Service Environment Variables
# SECURITY: Tokens are now loaded from root .env file
# This file only contains AI service-specific configuration

GEMINI_MODEL=gemini-2.5-flash
BACKEND_URL=http://localhost:9090/api

# Note: HF_API_TOKEN and GEMINI_API_KEY are loaded from root .env file
